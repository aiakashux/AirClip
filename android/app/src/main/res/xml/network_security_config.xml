<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config — development only.
    Allows cleartext (HTTP) traffic to the local dev server IP only.
    All other hosts continue to require TLS (Android 9+ default).
    Remove or replace this file before production release.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.48</domain>
    </domain-config>
</network-security-config>
